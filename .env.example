# ==========================================
# Kayak Environment Configuration Template
# Copy this file to .env and fill in your keys
# ==========================================

# Server Settings
KAYAK_HOST=0.0.0.0
KAYAK_PORT=8000
KAYAK_DEBUG=false

# Default Model Selection (LiteLLM Format)
KAYAK_DEFAULT_MODEL=gemini/gemini-3.6-flash

# Cloud Model Provider API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local / Self-Hosted Inference Endpoints
VLLM_API_BASE=http://localhost:8000/v1
OLLAMA_API_BASE=http://localhost:11434

# Docker Sandbox Settings
KAYAK_SANDBOX_IMAGE=kayak-sandbox:latest
DOCKER_SOCKET_PATH=/var/run/docker.sock
SANDBOX_TIMEOUT_SECONDS=3600
