# ==========================================
# Kayak Environment Configuration Template
#
# Nothing here is required: Kayak runs with no .env file at all. Provider API keys are
# not listed because they are not read from the environment -- start the app and enter
# them in the Settings page, which stores them in data/settings.json.
#
# Copy this file to .env only if you need to change how the server is deployed.
# ==========================================

# Server Settings
# Kayak gives agents shell and filesystem access, so it binds to loopback by
# default. Only change this if you also set KAYAK_AUTH_TOKEN.
KAYAK_HOST=127.0.0.1
KAYAK_PORT=8000
KAYAK_DEBUG=false

# Shared secret required on every API call. Leave empty to disable authentication
# (only safe on a loopback bind).
KAYAK_AUTH_TOKEN=

# Browser origins permitted to call the API, comma separated.
KAYAK_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Agent Execution Limits
KAYAK_AGENT_MAX_ITERATIONS=25
KAYAK_AGENT_MAX_SUBAGENT_DEPTH=3

# Local / Self-Hosted Inference Endpoints
# vLLM runs on 8001 so it does not collide with Kayak itself on 8000.
KAYAK_VLLM_PORT=8001
VLLM_API_BASE=http://localhost:8001/v1

# Docker Sandbox Settings
KAYAK_SANDBOX_IMAGE=kayak-sandbox:latest
DOCKER_SOCKET_PATH=/var/run/docker.sock
SANDBOX_TIMEOUT_SECONDS=3600
