# ==========================================
# Kayak Platform .gitignore
# ==========================================

# --- Secrets & Environment Variables ---
.env
.env.*
!.env.example
*.key
*.pem
data/settings.json
data/memories.md

# --- Database & Runtime State ---
data/kayak.db
data/kayak.db-wal
data/kayak.db-shm
*.db
*.sqlite
*.sqlite3
data/workspaces/*
!data/workspaces/.gitkeep
# Clips and transcripts the Audio page produces. Someone's own recordings and
# generated audio, in the same category as their conversations.
data/audio/*
!data/audio/.gitkeep
data/huggingface_cache/
data/agents/new_agent.yaml

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Testing & Type Checking ---
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# --- Node & Frontend ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.tsbuildinfo
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Operating System & Editors ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
*.bak

# --- Logs & Temp Files ---
*.log
logs/
temp/
tmp/
